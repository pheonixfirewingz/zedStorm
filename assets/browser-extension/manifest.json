{
  "manifest_version": 3,
  "name": "ZedStorm Web Search",
  "version": "1.0.0",
  "description": "Optional Chromium extension to connect web search to ZedStorm Context MCP",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.bing.com/*",
    "https://*.duckduckgo.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZedStorm Search Bridge"
  }
}
