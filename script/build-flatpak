#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
    echo "Usage: script/build-flatpak"
    echo "Requires Linux, Rust (rustup), flatpak, and flatpak-builder."
    echo "Installs the user Flatpak SDK, builds ZedStorm, and writes dist/zedstorm-linux-<architecture>.flatpak."
    exit 0
fi
if [[ $# -ne 0 ]]; then
    echo "Usage: script/build-flatpak" >&2
    exit 1
fi
if [[ "$(uname -s)" != Linux ]]; then
    echo "Flatpak builds require Linux." >&2
    exit 1
fi
for tool in flatpak flatpak-builder rustup cargo; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Missing required tool: $tool. Install it and rerun script/build-flatpak." >&2
        exit 1
    fi
done

repository_directory=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repository_directory"
cargo_directory=${CARGO_HOME:-$HOME/.cargo}
rustup_directory=${RUSTUP_HOME:-$HOME/.rustup}
architecture=$(flatpak --default-arch)
manifest=packaging/flatpak/dev.zedstorm.ZedStorm.yml
bundle="dist/zedstorm-linux-$architecture.flatpak"

rustup show active-toolchain
flatpak-builder --show-manifest "$manifest" >/dev/null
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --user --noninteractive -y flathub \
    org.freedesktop.Platform//25.08 \
    org.freedesktop.Sdk//25.08 \
    org.freedesktop.Sdk.Extension.llvm20//25.08

./script/generate-licenses

flatpak run --user --command=bash --share=network \
    --filesystem="$repository_directory" \
    --filesystem="$cargo_directory" --filesystem="$rustup_directory" \
    --env=CARGO_HOME="$cargo_directory" --env=RUSTUP_HOME="$rustup_directory" \
    --env=CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}" \
    --env=CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}" \
    --env=CARGO_PROFILE_RELEASE_DEBUG="${CARGO_PROFILE_RELEASE_DEBUG:-0}" \
    --env=CARGO_PROFILE_RELEASE_LTO="${CARGO_PROFILE_RELEASE_LTO:-false}" \
    --env=CC=/usr/lib/sdk/llvm20/bin/clang \
    --env=CXX=/usr/lib/sdk/llvm20/bin/clang++ \
    --env=LIBCLANG_PATH=/usr/lib/sdk/llvm20/lib \
    org.freedesktop.Sdk//25.08 -c \
    'set -euo pipefail; export PATH="$CARGO_HOME/bin:/usr/lib/sdk/llvm20/bin:$PATH"; cd "$1"; cargo build --release --locked --package zed --bin zed --target-dir target' \
    bash "$repository_directory"

flatpak-builder --user --force-clean --disable-rofiles-fuse \
    --state-dir=target/flatpak-state --repo=target/flatpak-repo \
    target/flatpak-build "$manifest"
echo "Checking the packaged executable..."
flatpak build --runtime target/flatpak-build /app/bin/zedstorm --help
mkdir -p dist
echo "Creating $bundle (compression can take several minutes without further output)..."
flatpak build-bundle target/flatpak-repo "$bundle" dev.zedstorm.ZedStorm \
    --runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo

echo "Built $repository_directory/$bundle"
